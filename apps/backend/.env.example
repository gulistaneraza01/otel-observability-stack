PORT=3000

NODE_ENV=development
SERVICE_NAME=backend

LOG_LEVEL=info

# OpenTelemetry — where the app sends logs/traces/metrics (OTel Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=backend
# set `true` only when the otel-collector (docker) is running
OTEL_SDK_ENABLED=false

# Background worker (periodic log emission) — set BG_ENABLED=false to disable
BG_ENABLED=true
BG_INTERVAL_MS=10000

# Optional: override the base URL used by /test/multi-hop self-calls
# SELF_URL=http://localhost:8000

# Postgres — your database connection
DATABASE_URL="postgresql://user:password@host:5432/db"
DATABASE_URL_POOLED="postgresql://user:password@host:5432/db?pooled=true"

# Storage — S3-compatible object storage (buckets for Loki/Thanos/Tempo)
AWS_ENDPOINT_URL_S3="https://s3.ap-southeast-1.amazonaws.com"
AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"
AWS_REGION="ap-southeast-1"
S3_BUCKET_LOGS="logs"
S3_BUCKET_METRICS="metrics"
S3_BUCKET_TRACES="traces"
